# Domain für TLS und WebAuthn
RP_ID=langdar.mywire.org
ORIGIN=https://langdar.mywire.org
RP_NAME=Bedrock Admin

# Session-Secret (unbedingt ändern!)
SESSION_SECRET=change-me-in-production

# Pfad zum Bedrock-Server-Datenverzeichnis (auf dem Host)
BEDROCK_DATA_PATH=/opt/bedrock/data

# Name des laufenden Bedrock Docker-Containers
BEDROCK_CONTAINER_NAME=bedrock
